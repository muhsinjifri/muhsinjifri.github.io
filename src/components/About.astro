---
// About: different waters, same hands on the wheel. A short bio, how I work, certifications, education
// and the toolbox.
// Confidentiality: no employer name, no dates of employment, no graduation year.
import Section from './Section.astro';
import SeaChart from './diagrams/SeaChart.astro';
import '../styles/diagram.css';

const principles = [
  {
    title: 'Make the right way the easy way',
    text: 'Shared modules, pipeline templates and one Helm chart, so a new service starts from something that already works.',
  },
  {
    title: 'Build once, promote everywhere',
    text: 'The image tested in DEV is the image that reaches PROD. Nothing gets rebuilt on the way up.',
  },
  {
    title: 'Warn before it breaks',
    text: 'Every alert gets an earlier warning level, so there is time to act before anyone gets paged.',
  },
  {
    title: 'Leave notes behind',
    text: 'Incidents end with a runbook the next person can follow, not just a fix only I understand.',
  },
];

const certs = [
  {
    name: 'AWS Certified Solutions Architect – Associate',
    code: 'SAA-C03',
    year: '2025',
    href: 'https://www.credly.com/badges/bdd0eda1-411b-4cd4-a2b6-10155483f8cf',
  },
  {
    name: 'HashiCorp Certified: Terraform Associate',
    code: '004',
    year: '2026',
    href: 'https://www.credly.com/badges/fff54a45-392c-44fd-9e08-bd745c8e09a3',
  },
];

const toolbox = [
  { area: 'Cloud', tools: 'AWS daily: EKS, EC2, VPC, IAM, ECR, S3, Route 53, CloudFront' },
  { area: 'On projects', tools: 'GCP (Cloud Run, Cloud SQL, Cloud Build), Azure, Cloudflare' },
  { area: 'Containers', tools: 'Kubernetes, Docker, Helm' },
  { area: 'Delivery', tools: 'GitLab CI, Argo CD, GitHub Actions' },
  { area: 'Infrastructure', tools: 'Terraform' },
  { area: 'Observability', tools: 'Datadog, CloudWatch, Splunk' },
  { area: 'Everyday', tools: 'Linux, Bash, Python, Git' },
];
---

<Section id="about" number="04" title="About" meta="Background">
  <div class="intro cols">
    <figure class="drawing">
      <div class="sea">
        <SeaChart />
      </div>
      <figcaption class="legend micro">
        <span><i class="key key-home"></i>Home port · daily work</span>
        <span><i class="key key-work"></i>Charted at work</span>
        <span><i class="key key-project"></i>Charted on projects</span>
      </figcaption>
    </figure>

    <div class="bio">
      <p class="lead">
        The tools change. The job doesn’t: make it reproducible, make it observable, make it boring.
      </p>
      <p>
        I’ve done that job on both sides of most stacks: AWS at work and GCP, Azure and Cloudflare on my own
        projects; Kubernetes clusters and serverless containers; GitLab CI and GitHub Actions; Datadog,
        CloudWatch and Splunk; Java services I deploy and Python APIs I write.
      </p>
      <p>
        When a team runs something I haven’t touched yet, I learn it the same way: read it, write it down as
        code, then make it quiet. Along the way I help less experienced engineers with troubleshooting,
        Kubernetes and monitoring.
      </p>
    </div>
  </div>

  <section class="how" aria-labelledby="about-how">
    <h3 class="group-title micro" id="about-how">How I work</h3>
    <ol class="principles cols">
      {
        principles.map((p, i) => (
          <li>
            <span class="num micro">{String(i + 1).padStart(2, '0')}</span>
            <h4>{p.title}</h4>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="facts cols">
    <section class="fact" aria-labelledby="about-certs">
      <h3 class="fact-title micro" id="about-certs">Certifications</h3>
      <ul class="certs">
        {
          certs.map((c) => (
            <li>
              <span class="cert-name">{c.name}</span>
              <a class="cert-meta mono" href={c.href} rel="noopener">
                {c.code} · {c.year} · Verify on Credly ↗
              </a>
            </li>
          ))
        }
        <li class="next">
          <span class="cert-name">Certified Kubernetes Administrator</span>
          <span class="cert-meta mono">CKA · preparing</span>
        </li>
      </ul>
    </section>

    <section class="fact" aria-labelledby="about-edu">
      <h3 class="fact-title micro" id="about-edu">Education</h3>
      <p class="edu-degree">B.Tech, Mechanical Engineering</p>
      <p class="edu-school">National Institute of Technology Calicut</p>

      <h3 class="fact-title fact-title-next micro" id="about-lead">Off the keyboard</h3>
      <p class="edu-note">
        Convenor of Ragam’23, NIT Calicut’s annual cultural festival: 200+ events, 30+ committees and 100+
        student leads to keep in step.
      </p>
    </section>

    <section class="fact fact-wide" aria-labelledby="about-tools">
      <h3 class="fact-title micro" id="about-tools">Toolbox</h3>
      <dl class="tools">
        {
          toolbox.map((t) => (
            <div>
              <dt class="mono">{t.area}</dt>
              <dd>{t.tools}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Section>

<script>
  // Sail the ship along the course as the chart scrolls into view, leaving a vermilion wake.
  // Without JS, or for anyone who prefers less motion, the voyage is shown complete.
  const wake = document.querySelector<SVGPathElement>('[data-wake]');
  const ship = document.querySelector<SVGGElement>('[data-ship]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  if (wake && ship && !still.matches) {
    const chart = wake.ownerSVGElement!;
    const length = wake.getTotalLength();
    wake.style.strokeDasharray = `${length}`;
    let queued = false;

    const sail = () => {
      queued = false;
      const box = chart.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the chart's top enters the bottom of the screen, 1 when its middle reaches 40% from the top
      const p = Math.min(1, Math.max(0, (vh - box.top) / (vh * 0.6 + box.height / 2)));
      const at = Math.max(1, p * length);
      const here = wake.getPointAtLength(at);
      const back = wake.getPointAtLength(at - 1);
      const angle = (Math.atan2(here.y - back.y, here.x - back.x) * 180) / Math.PI;
      wake.style.strokeDashoffset = `${length - at}`;
      ship.setAttribute('transform', `translate(${here.x.toFixed(1)} ${here.y.toFixed(1)}) rotate(${angle.toFixed(1)})`);
    };

    sail();
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(sail);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /*
    One 4-column grid for the whole section, so the chart, the bio, the principles and the facts
    all share the same vertical edges. It drops to 2 columns, then 1.
  */
  .cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-6);
  }

  .intro {
    align-items: start;
  }

  .drawing {
    grid-column: span 2;
    margin: 0;
  }

  .bio {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 62ch;
  }

  .lead {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .key {
    width: 14px;
    height: 10px;
    border: 1px solid var(--ink);
  }

  .key-home {
    background: var(--vermilion);
  }

  .key-work {
    background: var(--paper);
  }

  .key-project {
    background: repeating-linear-gradient(45deg, var(--ink) 0 1px, var(--paper) 1px 4px);
  }

  /* group and fact labels: the same mono caps as the section meta */
  .group-title,
  .fact-title {
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .how {
    margin-top: var(--space-8);
  }

  /* heavy rule = a group (How I work, Certifications…); hairline = an item inside it */
  .group-title {
    padding-top: var(--space-3);
    margin-bottom: var(--space-5);
    border-top: var(--rule);
  }

  .principles {
    row-gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* subgrid: number, title and text line up across the principles in a row */
  .principles li {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    align-content: start;
    row-gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--hairline);
  }

  .num {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .principles h4 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .principles p {
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .facts {
    row-gap: var(--space-7);
    margin-top: var(--space-8);
  }

  .fact-wide {
    grid-column: span 2;
  }

  .fact-title {
    padding-top: var(--space-3);
    margin-bottom: var(--space-4);
    border-top: var(--rule);
  }

  .fact-title-next {
    margin-top: var(--space-6);
  }

  .certs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs li {
    display: flex;
    flex-direction: column;
  }

  .cert-name {
    font-weight: 600;
    line-height: 1.3;
  }

  /* 44px tall so the verify links are easy to tap */
  .cert-meta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step--2);
  }

  .next .cert-name,
  .next .cert-meta {
    color: var(--muted);
    font-weight: 400;
  }

  .edu-degree {
    font-weight: 600;
  }

  .edu-school {
    color: var(--muted);
  }

  .edu-note {
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .tools {
    margin: 0;
  }

  .tools div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .tools div:first-child {
    padding-top: 0;
  }

  .tools dt {
    color: var(--muted);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 0.15em;
  }

  .tools dd {
    margin: 0;
  }

  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .drawing,
    .bio {
      grid-column: 1 / -1;
    }

    /* keep chart labels smaller than body text */
    .drawing {
      max-width: 40rem;
    }

    .intro {
      row-gap: var(--space-6);
    }

    /* the line first, then the chart that illustrates it */
    .bio {
      order: -1;
      max-width: 62ch;
    }
  }

  @media (max-width: 640px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }

    .fact-wide {
      grid-column: auto;
    }
  }

  /* on phones the chart keeps a readable size and scrolls sideways, like the case-study diagrams */
  @media (max-width: 760px) {
    .sea {
      overflow-x: auto;
    }

    .sea :global(.diagram) {
      min-width: 560px;
    }
  }
</style>
