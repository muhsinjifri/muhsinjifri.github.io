---
import HelmWheel from './HelmWheel.astro';

const notes = [
  ['Kubernetes (n.)', 'Greek for helmsman'],
  ['Steered 20 services', 'from EC2 to Amazon EKS'],
  ['Helm · Argo CD', 'Terraform · AWS'],
  ['Bengaluru, India', 'IST · UTC+5:30'],
];

// Twelve-point starburst for the corner.
const burst = Array.from({ length: 24 }, (_, i) => {
  const a = (Math.PI * i) / 12 - Math.PI / 2;
  const r = i % 2 === 0 ? 100 : 60;
  return `${+(r * Math.cos(a)).toFixed(1)},${+(r * Math.sin(a)).toFixed(1)}`;
}).join(' ');
---

<section class="hero wrap" aria-labelledby="hero-title">
  <ul class="notes" aria-label="Quick facts">
    {notes.map(([a, b]) => <li><span>{a}</span><span>{b}</span></li>)}
  </ul>

  <!--
    The artwork has two layers with the headline between them:
    the sun and orbit sit behind the words, the wheel passes in front.
    .art has no z-index of its own, so its layers stack with the headline.
  -->
  <div class="art" aria-hidden="true">
    <div class="stage stage--back">
      <svg viewBox="-300 -300 600 600">
        <circle r="232" class="sun"></circle>
        <circle r="292" class="orbit"></circle>
        <circle cx="230.1" cy="-179.8" r="7" class="orbit-dot"></circle>
      </svg>
    </div>
    <div class="stage stage--front">
      <HelmWheel />
    </div>
    <span class="spark"></span>
  </div>

  <div class="copy">
    <p class="tagline" aria-hidden="true">
      <span>Steady hands</span>
      <span class="line--2">on the wheel<i class="full-stop"></i></span>
    </p>

    <div class="intro">
      <h1 id="hero-title">
        <span class="visually-hidden">Steady hands on the wheel. </span>
        Sayed Muhsin Jifri
        <span class="role">DevOps / Platform Engineer, Bengaluru</span>
      </h1>
      <p>
        I build and run the platform underneath: EKS clusters, Terraform, GitOps releases. Boring in production, on purpose.
      </p>
      <div class="cta">
        <a class="button" href="#work">See the work</a>
        <a href="/resume.pdf">Résumé (PDF)</a>
      </div>
    </div>
  </div>

  <svg class="burst" viewBox="-100 -100 200 200" aria-hidden="true"><polygon points={burst}></polygon></svg>
</section>

<script>
  // Turn the wheel a little as the page scrolls. Off for anyone who prefers less motion.
  const BASE = 14;
  const parts = document.querySelectorAll<SVGGElement>('.helm [data-spin]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;

  const turn = () => {
    queued = false;
    const angle = BASE + Math.min(window.scrollY, 2400) * 0.09;
    parts.forEach((g) => g.setAttribute('transform', `rotate(${angle.toFixed(2)})`));
  };

  if (!still.matches && parts.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(turn);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    /* The wheel is sized by whichever is tighter, the width or the height of the screen,
       so it never climbs into the notes row on short laptop screens. */
    --stage: clamp(300px, min(44vw, 100svh - 210px), 640px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stage);
    grid-template-rows: auto 1fr;
    column-gap: 0;
    row-gap: var(--space-6);
    padding-block: var(--space-4) var(--space-7);
    isolation: isolate;
  }

  /* micro-type row, as on a printed poster */
  .notes {
    grid-column: 1 / -1;
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: var(--hairline);
    list-style: none;
    font-size: var(--step--2);
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .notes li {
    display: flex;
    flex-direction: column;
  }

  .art {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: center;
    width: var(--stage);
    aspect-ratio: 1;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  .stage--back {
    z-index: 0;
  }

  .stage--front {
    z-index: 2;
    pointer-events: none;
  }

  .sun {
    fill: var(--vermilion);
  }

  .orbit {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-dot {
    fill: var(--ink);
  }

  .spark {
    position: absolute;
    left: 2%;
    bottom: 4%;
    z-index: 1;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--mustard);
  }

  /*
    The text column reaches a little way under the wheel, as far as the handle tips,
    but stops before the rim so every word stays readable. The headline is sized
    from the column's own width (each line is about 6.2em wide), so it never wraps.
  */
  .copy {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    margin-right: calc(var(--stage) * -0.13);
    container-type: inline-size;
  }

  .tagline {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-5);
    font-size: min(var(--step-display), 15.6cqi);
    white-space: nowrap;
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .line--2 {
    display: flex;
    align-items: baseline;
    gap: 0.06em;
    margin-left: 0.45em;
  }

  .full-stop {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    background: var(--ink);
  }

  .intro {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 25rem;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .role {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .button:hover {
    background: var(--vermilion);
    color: #151311;
  }

  .burst {
    position: absolute;
    right: calc(var(--gutter) * -0.6);
    bottom: -70px;
    z-index: 1;
    width: clamp(110px, 13vw, 180px);
    fill: var(--vermilion);
  }

  @media (max-width: 900px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-3);
    }
  }

  /* Phone: one column. The wheel comes first and the headline tucks under its lower handles. */
  @media (max-width: 760px) {
    .hero {
      --stage: min(92vw, 520px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      row-gap: var(--space-5);
      padding-bottom: var(--space-8);
    }

    .art {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
    }

    .copy {
      grid-column: 1;
      grid-row: 3;
      margin-right: 0;
      margin-top: calc(var(--stage) * -0.1);
    }

    .tagline {
      padding-top: 0;
      font-size: 15cqi;
    }

    .line--2 {
      margin-left: 0;
    }

    .spark,
    .burst {
      display: none;
    }
  }
</style>
