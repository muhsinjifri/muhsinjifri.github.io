---
import HelmWheel from './HelmWheel.astro';

// The spec strip under the header: label, then value, like the info bar on a poster.
const notes = [
  ['Etymology', 'Kubernetes (n.), Greek for helmsman'],
  ['Flagship', '20 services, EC2 → Amazon EKS'],
  ['Toolkit', 'Terraform · Helm · Argo CD'],
  ['Based in', 'Bengaluru, India · IST'],
];

// Compass rose: four cardinal points (north in vermilion), four smaller intercardinals, a ticked ring.
const pt = (deg: number, r: number) => {
  const t = (deg * Math.PI) / 180;
  return `${+(r * Math.sin(t)).toFixed(2)},${+(-r * Math.cos(t)).toFixed(2)}`;
};
const point = (deg: number, tip: number, side: number) => ({
  dark: `0,0 ${pt(deg, tip)} ${pt(deg - 45, side)}`,
  light: `0,0 ${pt(deg, tip)} ${pt(deg + 45, side)}`,
});
const cardinals = [0, 90, 180, 270].map((d) => point(d, 84, 15));
const intercardinals = [45, 135, 225, 315].map((d) => point(d, 54, 10));
const ticks = Array.from({ length: 72 }, (_, i) => {
  const d = i * 5;
  const long = d % 45 === 0;
  const [x1, y1] = pt(d, long ? 82 : 88).split(',');
  const [x2, y2] = pt(d, 94).split(',');
  return { x1, y1, x2, y2, long };
});
---

<section class="hero wrap" aria-labelledby="hero-title">
  <ul class="notes" aria-label="Quick facts">
    {
      notes.map(([k, v], i) => (
        <li>
          <span class="k">{String(i + 1).padStart(2, '0')} · {k}</span>
          <span class="v">{v}</span>
        </li>
      ))
    }
  </ul>

  <!--
    The artwork has two layers with the headline between them:
    the sun and orbit sit behind the words, the wheel passes in front.
    .art has no z-index of its own, so its layers stack with the headline.
  -->
  <div class="art" aria-hidden="true">
    <div class="drafting"></div>
    <div class="stage stage--back">
      <svg viewBox="-300 -300 600 600">
        <circle r="232" class="sun"></circle>
        <circle r="292" class="orbit"></circle>
        <circle cx="230.1" cy="-179.8" r="7" class="orbit-dot"></circle>
      </svg>
    </div>
    <div class="stage stage--front">
      <HelmWheel />
    </div>
    <svg class="compass" viewBox="-100 -100 200 200">
      <circle r="96" class="ring"></circle>
      <circle r="88" class="ring thin"></circle>
      <circle r="30" class="ring thin"></circle>
      {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={t.long ? 'tick long' : 'tick'}></line>)}
      {intercardinals.map((p) => <><polygon points={p.dark} class="dark"></polygon><polygon points={p.light} class="light"></polygon></>)}
      {cardinals.map((p, i) => <><polygon points={p.dark} class={i === 0 ? 'north' : 'dark'}></polygon><polygon points={p.light} class={i === 0 ? 'north-light' : 'light'}></polygon></>)}
      <circle r="7" class="brass"></circle>
    </svg>
  </div>

  <div class="copy">
    <p class="tagline" aria-hidden="true">
      <span>Steady hands</span>
      <span class="line--2">on the wheel<i class="full-stop"></i></span>
    </p>

    <div class="intro">
      <h1 id="hero-title">
        <span class="visually-hidden">Steady hands on the wheel. </span>
        Sayed Muhsin Jifri
        <span class="role">DevOps / Platform Engineer, Bengaluru</span>
      </h1>
      <p>
        I build and run the platform underneath: EKS clusters, Terraform, GitOps releases. Boring in production, on purpose.
      </p>
      <div class="cta">
        <a class="button" href="#work">See the work</a>
        <a href="/resume.pdf">Résumé (PDF)</a>
      </div>
    </div>
  </div>

</section>

<script>
  // Turn the wheel a little as the page scrolls. Off for anyone who prefers less motion.
  const BASE = 14;
  const parts = document.querySelectorAll<SVGGElement>('.helm [data-spin]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;

  const turn = () => {
    queued = false;
    const angle = BASE + Math.min(window.scrollY, 2400) * 0.09;
    parts.forEach((g) => g.setAttribute('transform', `rotate(${angle.toFixed(2)})`));
  };

  if (!still.matches && parts.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(turn);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    /* The wheel is sized by whichever is tighter, the width or the height of the screen,
       so it never climbs into the notes row on short laptop screens. */
    --stage: clamp(300px, min(44vw, 100svh - 210px), 640px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stage);
    grid-template-rows: auto 1fr;
    column-gap: 0;
    row-gap: var(--space-6);
    padding-block: 0 var(--space-7);
    isolation: isolate;
  }

  /* Spec strip: a heavy rule on top, hairline dividers, label over value. */
  .notes {
    grid-column: 1 / -1;
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: var(--rule);
    border-bottom: var(--hairline);
    list-style: none;
  }

  .notes li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-3);
  }

  .notes li:nth-child(n + 2) {
    border-left: var(--hairline);
  }

  .notes li:first-child {
    padding-left: 0;
  }

  .k {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: var(--muted);
  }

  .v {
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .art {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: center;
    width: var(--stage);
    aspect-ratio: 1;
  }

  .stage {
    position: absolute;
    inset: 0;
  }

  /* Drafting paper behind the wheel, fading out at the edges: a nod to engineering drawings. */
  .drafting {
    position: absolute;
    inset: -12%;
    z-index: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: center;
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
  }

  .stage--back {
    z-index: 0;
  }

  .stage--front {
    z-index: 2;
    pointer-events: none;
  }

  .sun {
    fill: var(--vermilion);
  }

  .orbit {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-dot {
    fill: var(--ink);
  }

  .compass {
    position: absolute;
    left: -7%;
    bottom: -3%;
    z-index: 3;
    width: 21%;
    overflow: visible;
  }

  .compass .ring {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .compass .ring.thin {
    fill: none;
    stroke-width: 0.9;
  }

  .compass .tick {
    stroke: var(--ink);
    stroke-width: 0.9;
  }

  .compass .tick.long {
    stroke-width: 1.6;
  }

  .compass .dark {
    fill: var(--ink);
  }

  .compass .light {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .compass .north {
    fill: var(--vermilion);
  }

  .compass .north-light {
    fill: var(--vermilion);
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
    opacity: 0.55;
  }

  .compass .brass {
    fill: var(--mustard);
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  /*
    The text column stops short of the wheel so nothing in the headline is covered.
    The headline is sized
    from the column's own width (each line is about 6.2em wide), so it never wraps.
  */
  .copy {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-7);
    margin-right: var(--space-6);
    container-type: inline-size;
  }

  .tagline {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-5);
    font-family: var(--font-display);
    /* Big Shoulders caps: the wider line is about 6.1em, so 16.4cqi fills the column. */
    font-size: min(8.5rem, 16.4cqi);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .line--2 {
    display: flex;
    align-items: baseline;
    gap: 0.06em;
    margin-left: 0.3em;
  }

  .full-stop {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    background: var(--ink);
  }

  .intro {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 25rem;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .role {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .button:hover {
    background: var(--vermilion);
    color: #151311;
  }

  @media (max-width: 900px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .notes li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .notes li:nth-child(n + 3) {
      border-top: var(--hairline);
    }
  }

  /* Phone: one column. The wheel comes first, the headline sits below it. */
  @media (max-width: 760px) {
    .hero {
      --stage: min(92vw, 520px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      row-gap: var(--space-5);
      padding-bottom: var(--space-8);
    }

    .art {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
    }

    .copy {
      grid-column: 1;
      grid-row: 3;
      margin-right: 0;
    }

    .tagline {
      padding-top: 0;
      font-size: 16.4cqi;
    }

    .line--2 {
      margin-left: 0;
    }

    .compass {
      left: auto;
      right: -1%;
      bottom: -1%;
      width: 19%;
    }
  }
</style>
