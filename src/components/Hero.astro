---
import HelmWheel from './HelmWheel.astro';

const notes = [
  ['Kubernetes (n.)', 'Greek for helmsman'],
  ['Steered 20 services', 'from EC2 to Amazon EKS'],
  ['Helm · Argo CD', 'Terraform · AWS'],
  ['Bengaluru, India', 'IST · UTC+5:30'],
];

// Twelve-point starburst for the corner.
const burst = Array.from({ length: 24 }, (_, i) => {
  const a = (Math.PI * i) / 12 - Math.PI / 2;
  const r = i % 2 === 0 ? 100 : 60;
  return `${+(r * Math.cos(a)).toFixed(1)},${+(r * Math.sin(a)).toFixed(1)}`;
}).join(' ');
---

<section class="hero wrap" aria-labelledby="hero-title">
  <ul class="notes" aria-label="Quick facts">
    {notes.map(([a, b]) => <li><span>{a}</span><span>{b}</span></li>)}
  </ul>

  <!-- back layer: the sun and its orbit sit behind the headline -->
  <div class="stage stage--back" aria-hidden="true">
    <svg viewBox="-300 -300 600 600">
      <circle r="232" class="sun"></circle>
      <circle r="292" class="orbit"></circle>
      <circle cx="230.1" cy="-179.8" r="7" class="orbit-dot"></circle>
    </svg>
  </div>

  <p class="tagline" aria-hidden="true">
    <span class="line line--1">Steady hands</span>
    <span class="line line--2">on the wheel<i class="full-stop"></i></span>
  </p>

  <!-- front layer: the wheel passes in front of the headline -->
  <div class="stage stage--front">
    <HelmWheel />
  </div>

  <div class="intro">
    <h1 id="hero-title">
      <span class="visually-hidden">Steady hands on the wheel. </span>
      Sayed Muhsin Jifri
      <span class="role">DevOps / Platform Engineer, Bengaluru</span>
    </h1>
    <p>
      I build and run the platform underneath: EKS clusters, Terraform, GitOps releases. Boring in production, on purpose.
    </p>
    <div class="cta">
      <a class="button" href="#work">See the work</a>
      <a href="/resume.pdf">Résumé (PDF)</a>
    </div>
  </div>

  <svg class="burst" viewBox="-100 -100 200 200" aria-hidden="true"><polygon points={burst}></polygon></svg>
  <span class="spark" aria-hidden="true"></span>
</section>

<script>
  // Turn the wheel a little as the page scrolls. Off for anyone who prefers less motion.
  const BASE = 14;
  const parts = document.querySelectorAll<SVGGElement>('.helm [data-spin]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;

  const turn = () => {
    queued = false;
    const angle = BASE + Math.min(window.scrollY, 2400) * 0.09;
    parts.forEach((g) => g.setAttribute('transform', `rotate(${angle.toFixed(2)})`));
  };

  if (!still.matches && parts.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(turn);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .hero {
    --stage: clamp(360px, 47vw, 660px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(640px, calc(100svh - 90px), 880px);
    padding-block: var(--space-4) var(--space-7);
    isolation: isolate;
  }

  /* micro-type row, as on a printed poster */
  .notes {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: var(--hairline);
    list-style: none;
    font-size: var(--step--2);
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .notes li {
    display: flex;
    flex-direction: column;
  }

  .stage {
    position: absolute;
    top: 50%;
    right: calc(var(--gutter) - var(--stage) * 0.04);
    width: var(--stage);
    aspect-ratio: 1;
    translate: 0 -46%;
  }

  .stage--back {
    z-index: 0;
  }

  .stage--front {
    z-index: 2;
    pointer-events: none;
  }

  .sun {
    fill: var(--vermilion);
  }

  .orbit {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-dot {
    fill: var(--ink);
  }

  .tagline {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    margin-top: var(--space-7);
    font-size: var(--step-display);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .line--2 {
    display: flex;
    align-items: baseline;
    gap: 0.06em;
    margin-left: clamp(0px, 3vw, 48px);
  }

  .full-stop {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    background: var(--ink);
  }

  .intro {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 25rem;
    margin-top: var(--space-7);
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .role {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
  }

  .intro p {
    font-size: var(--step-0);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  .button:hover {
    background: var(--vermilion);
    color: #151311;
  }

  .burst {
    position: absolute;
    right: calc(var(--gutter) * -0.6);
    bottom: -70px;
    z-index: 1;
    width: clamp(110px, 13vw, 180px);
    fill: var(--vermilion);
  }

  .spark {
    position: absolute;
    left: 46%;
    bottom: var(--space-8);
    z-index: 1;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--mustard);
  }

  @media (max-width: 900px) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-3);
    }
  }

  /* Phone: the wheel sits on top, the headline slides underneath its lower half. */
  @media (max-width: 760px) {
    .hero {
      --stage: min(94vw, 520px);
      min-height: 0;
      justify-content: flex-start;
      padding-bottom: var(--space-8);
    }

    .stage {
      top: calc(var(--space-8) + 3.2rem);
      right: 50%;
      translate: 50% 0;
    }

    .tagline {
      margin-top: calc(var(--stage) * 0.93);
    }

    .line--2 {
      margin-left: 0;
    }

    .spark,
    .burst {
      display: none;
    }
  }
</style>
