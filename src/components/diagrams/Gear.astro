---
// A spur gear drawn like a mechanical engineering drawing: centre lines, pitch circle, a hatched quarter
// section and one dimension. It nods to the mechanical degree. The gear body turns on scroll (see About.astro).
const N = 14; // teeth
const RO = 130; // tip radius
const RR = 112; // root radius
const RP = 121; // pitch radius
const step = (2 * Math.PI) / N;
const pt = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;

let outline = '';
for (let i = 0; i < N; i++) {
  const a = i * step - Math.PI / 2;
  if (i === 0) outline += `M ${pt(RR, a)} `;
  outline += `L ${pt(RO, a + step * 0.16)} `;
  outline += `A ${RO} ${RO} 0 0 1 ${pt(RO, a + step * 0.46)} `;
  outline += `L ${pt(RR, a + step * 0.62)} `;
  outline += `A ${RR} ${RR} 0 0 1 ${pt(RR, a + step)} `;
}
outline += 'Z';

// Lightening holes in the web, between rim and hub.
const holes = Array.from({ length: 5 }, (_, i) => {
  const a = (i * 2 * Math.PI) / 5 - Math.PI / 2;
  return { cx: (72 * Math.cos(a)).toFixed(2), cy: (72 * Math.sin(a)).toFixed(2) };
});

// Bore with a keyway at the top.
const bore = 'M -5 -16 L -5 -21 L 5 -21 L 5 -16 A 16 16 0 1 1 -5 -16 Z';
---

<svg
  class="diagram gear"
  viewBox="-200 -200 400 400"
  role="img"
  aria-label="An engineering drawing of a fourteen-tooth spur gear with centre lines, a dashed pitch circle, a hatched quarter section and a 260 millimetre diameter dimension."
>
  <defs>
    <pattern id="gear-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="7" class="dg-line dg-thin"></line>
    </pattern>
    <clipPath id="gear-quarter">
      <rect x="0" y="-160" width="160" height="160"></rect>
    </clipPath>
    <marker id="gear-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 Z" class="dg-arrowhead"></path>
    </marker>
  </defs>

  <g class="gear-body" data-gear>
    <path d={outline} class="dg-box"></path>
    <!-- quarter section: web hatched, holes and bore stay open -->
    <g clip-path="url(#gear-quarter)">
      <path d={outline} fill="url(#gear-hatch)"></path>
    </g>
    <circle r="98" class="dg-line dg-thin"></circle>
    {holes.map((h) => <circle cx={h.cx} cy={h.cy} r="17" class="dg-box"></circle>)}
    <circle r="40" class="dg-hot"></circle>
    <path d={bore} class="dg-box"></path>
  </g>

  <!-- centre lines and pitch circle stay put -->
  <circle r={RP} class="dg-line dg-thin gear-center"></circle>
  <line x1="-160" y1="0" x2="160" y2="0" class="dg-line dg-thin gear-center"></line>
  <line x1="0" y1="-160" x2="0" y2="160" class="dg-line dg-thin gear-center"></line>

  <!-- overall diameter -->
  <line x1="-130" y1="-8" x2="-130" y2="-182" class="dg-line dg-thin"></line>
  <line x1="130" y1="-8" x2="130" y2="-182" class="dg-line dg-thin"></line>
  <line
    x1="-128"
    y1="-172"
    x2="128"
    y2="-172"
    class="dg-line dg-thin"
    marker-start="url(#gear-arrow)"
    marker-end="url(#gear-arrow)"
  ></line>
  <rect x="-26" y="-182" width="52" height="16" class="gear-label-bg"></rect>
  <text x="0" y="-170" text-anchor="middle" class="dg-text dg-small">Ø260</text>

  <!-- leader to the teeth -->
  <polyline points="-110,120 -150,168 -186,168" class="dg-line dg-thin"></polyline>
  <text x="-186" y="162" class="dg-text dg-small">z = 14</text>
  <text x="96" y="178" class="dg-text dg-small dg-muted">SECTION A–A</text>
</svg>

<style>
  .gear {
    overflow: visible;
  }

  .gear .gear-center {
    stroke-dasharray: 14 3 2 3;
  }

  .gear .gear-label-bg {
    fill: var(--paper);
  }
</style>
