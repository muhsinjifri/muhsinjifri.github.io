---
// Three standards feed one platform baseline, which every team's services start from.
const standards = [
  { title: 'GitLab CI templates', sub: 'include, set variables, ship' },
  { title: 'Terraform conventions', sub: 'naming · tagging · state' },
  { title: 'Standard Helm chart', sub: 'one values structure' },
].map((s, i) => ({ ...s, y: 30 + i * 74 }));

const teams = ['A', 'B', 'C'].map((t, i) => ({ label: `Team ${t}`, y: 30 + i * 74 }));
---

<svg
  class="diagram"
  viewBox="0 0 680 270"
  role="img"
  aria-label="Three standards, reusable GitLab CI templates, Terraform module conventions and a standard Helm chart, form one platform baseline that services across several teams start from."
>
  <defs>
    <pattern id="std-grid" width="16" height="16" patternUnits="userSpaceOnUse">
      <path d="M 16 0 L 0 0 0 16" class="dg-gridline"></path>
    </pattern>
    <marker id="std-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 L10 5 L0 10 Z" class="dg-arrowhead"></path>
    </marker>
  </defs>
  <rect width="680" height="270" fill="url(#std-grid)"></rect>

  {
    standards.map((s) => (
      <g>
        <rect x="10" y={s.y} width="196" height="52" class="dg-box"></rect>
        <text x="22" y={s.y + 22} class="dg-text dg-strong">{s.title}</text>
        <text x="22" y={s.y + 39} class="dg-text dg-small dg-muted">{s.sub}</text>
        <path d={`M 206 ${s.y + 26} H 240 V 129 H 268`} class="dg-line" marker-end="url(#std-arrow)"></path>
      </g>
    ))
  }

  <rect x="270" y="98" width="140" height="62" class="dg-hot"></rect>
  <text x="340" y="125" text-anchor="middle" class="dg-text dg-strong dg-on-hot">platform</text>
  <text x="340" y="142" text-anchor="middle" class="dg-text dg-strong dg-on-hot">baseline</text>

  {
    teams.map((t) => (
      <g>
        <path d={`M 410 129 H 440 V ${t.y + 26} H 466`} class="dg-line dg-thin" marker-end="url(#std-arrow)"></path>
        <rect x="468" y={t.y} width="202" height="52" class="dg-box"></rect>
        <text x="480" y={t.y + 31} class="dg-text dg-strong">{t.label}</text>
        <rect x="548" y={t.y + 12} width="54" height="28" class="dg-box dg-thin"></rect>
        <text x="575" y={t.y + 30} text-anchor="middle" class="dg-text dg-small dg-muted">svc</text>
        <rect x="608" y={t.y + 12} width="54" height="28" class="dg-box dg-thin"></rect>
        <text x="635" y={t.y + 30} text-anchor="middle" class="dg-text dg-small dg-muted">svc</text>
      </g>
    ))
  }
  <text x="10" y="258" class="dg-text dg-small dg-muted">teams build on one shared baseline instead of reinventing it per service</text>
</svg>
