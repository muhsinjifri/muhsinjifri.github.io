---
// Before: one service per EC2 instance. After: services as pods on Amazon EKS, Spot node groups, autoscaling.
const vms = Array.from({ length: 8 }, (_, i) => ({ x: 20 + (i % 2) * 92, y: 52 + Math.floor(i / 2) * 50 }));
const pods = (x0: number) =>
  Array.from({ length: 9 }, (_, i) => ({ cx: x0 + 26 + (i % 3) * 34, cy: 112 + Math.floor(i / 3) * 28 }));
---

<svg
  class="diagram"
  viewBox="0 0 680 300"
  role="img"
  aria-label="Before: each service on its own EC2 instance running Tomcat. After: the services run as pods on an Amazon EKS cluster behind an Application Load Balancer, on Spot node groups scaled by the Cluster Autoscaler and HPA."
>
  <defs>
    <pattern id="mig-grid" width="16" height="16" patternUnits="userSpaceOnUse">
      <path d="M 16 0 L 0 0 0 16" class="dg-gridline"></path>
    </pattern>
    <marker id="mig-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0 0 L10 5 L0 10 Z" class="dg-arrowhead"></path>
    </marker>
  </defs>
  <rect width="680" height="300" fill="url(#mig-grid)"></rect>

  <text x="20" y="34" class="dg-text dg-strong">BEFORE · one service per EC2</text>
  {
    vms.map((v) => (
      <g>
        <rect x={v.x} y={v.y} width="80" height="38" class="dg-box"></rect>
        <rect x={v.x + 8} y={v.y + 9} width="20" height="20" class="dg-solid"></rect>
        <text x={v.x + 34} y={v.y + 17} class="dg-text dg-small">EC2</text>
        <text x={v.x + 34} y={v.y + 29} class="dg-text dg-small dg-muted">Tomcat</text>
      </g>
    ))
  }
  <text x="20" y="268" class="dg-text dg-small dg-muted">deployed by hand, per server</text>

  <line x1="208" y1="150" x2="306" y2="150" class="dg-line" marker-end="url(#mig-arrow)"></line>
  <text x="257" y="140" text-anchor="middle" class="dg-text dg-small">containerise</text>
  <text x="257" y="168" text-anchor="middle" class="dg-text dg-small">Helm + Argo CD</text>

  <text x="320" y="34" class="dg-text dg-strong">AFTER · Amazon EKS</text>
  <rect x="320" y="52" width="340" height="206" rx="16" class="dg-hot"></rect>
  <rect x="452" y="42" width="76" height="22" class="dg-solid"></rect>
  <text x="490" y="57" text-anchor="middle" class="dg-text dg-small dg-invert">ALB</text>

  <rect x="336" y="84" width="150" height="112" rx="8" class="dg-on-hot-line dg-dash"></rect>
  <rect x="500" y="84" width="144" height="112" rx="8" class="dg-on-hot-line dg-dash"></rect>
  {pods(336).map((p) => <circle cx={p.cx} cy={p.cy} r="8" class="dg-on-hot-solid"></circle>)}
  {pods(497).map((p) => <circle cx={p.cx} cy={p.cy} r="8" class="dg-on-hot-solid"></circle>)}
  <text x="336" y="212" class="dg-text dg-small dg-on-hot">node group · Spot</text>
  <text x="500" y="212" class="dg-text dg-small dg-on-hot">node group · Spot</text>
  <text x="336" y="240" class="dg-text dg-small dg-on-hot">Cluster Autoscaler · HPA · probes · EFS</text>

  <line x1="20" y1="282" x2="660" y2="282" class="dg-line dg-thin"></line>
  <line x1="20" y1="276" x2="20" y2="288" class="dg-line dg-thin"></line>
  <line x1="660" y1="276" x2="660" y2="288" class="dg-line dg-thin"></line>
  <rect x="290" y="274" width="100" height="16" fill="var(--paper)"></rect>
  <text x="340" y="286" text-anchor="middle" class="dg-text dg-small">20 microservices</text>
</svg>
