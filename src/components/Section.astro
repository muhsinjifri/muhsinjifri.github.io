---
interface Props {
  id: string;
  number: string;
  title: string;
  meta?: string;
}

const { id, number, title, meta } = Astro.props;
---

<section class="section wrap" id={id} aria-labelledby={`${id}-title`}>
  <header class="section-head micro">
    <span>{number} / <span id={`${id}-title`}>{title}</span></span>
    {meta && <span>{meta}</span>}
  </header>
  <div class="section-body">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-8);
    scroll-margin-top: var(--space-5);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--rule);
  }

  .section-body {
    margin-top: var(--space-6);
  }
</style>
