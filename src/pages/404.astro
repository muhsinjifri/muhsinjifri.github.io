---
// 404, styled as an incident: a giant 404 with a traffic cone standing in front of the 0.
// The hero's "Deploy to prod" link lands here on purpose.
import Base from '../layouts/Base.astro';

// Cone geometry (viewBox 0 0 400 520). The body is a cone with an elliptical foot; the bands follow its curve.
const CX = 200;
const TIP = 30;
const FOOT = 440;
const tipHalf = 14;
const footHalf = 150;
const footRy = 22;
const half = (y: number) => tipHalf + ((footHalf - tipHalf) * (y - TIP)) / (FOOT - TIP);
const ry = (y: number) => (footRy * half(y)) / footHalf;

const body =
  `M ${CX - tipHalf} ${TIP} Q ${CX} ${TIP - 24} ${CX + tipHalf} ${TIP} ` +
  `L ${CX + footHalf} ${FOOT} A ${footHalf} ${footRy} 0 0 1 ${CX - footHalf} ${FOOT} Z`;

const band = (y1: number, y2: number) => {
  const [h1, h2] = [half(y1), half(y2)];
  return (
    `M ${CX - h1} ${y1} A ${h1} ${ry(y1)} 0 0 0 ${CX + h1} ${y1} ` +
    `L ${CX + h2} ${y2} A ${h2} ${ry(y2)} 0 0 1 ${CX - h2} ${y2} Z`
  );
};
const bands = [band(150, 196), band(272, 324)];

const strip = [
  { label: 'Incident', value: '#404' },
  { label: 'Severity', value: 'Low' },
  { label: 'Status', value: 'Investigating' },
  { label: 'On call', value: 'S. M. Jifri' },
];
---

<Base title="Incident #404 · Sayed Muhsin Jifri" description="This page didn't make it to prod. The homepage is healthy.">
  <main id="main" class="incident wrap">
    <ul class="strip">
      {
        strip.map((s) => (
          <li>
            <span class="micro label">{s.label}</span>
            <span class="value">{s.value}</span>
          </li>
        ))
      }
    </ul>

    <div class="scene" aria-hidden="true">
      <span class="circle"></span>
      <span class="dot"></span>
      <span class="square"></span>
      <p class="big">404</p>

      <svg class="cone" viewBox="0 0 400 520">
        <defs>
          <linearGradient id="cone-body" x1="0" x2="1">
            <stop offset="0" stop-color="#f7956a"></stop>
            <stop offset="0.38" stop-color="#f05a1e"></stop>
            <stop offset="0.62" stop-color="#e2470f"></stop>
            <stop offset="1" stop-color="#a32e08"></stop>
          </linearGradient>
          <linearGradient id="cone-band" x1="0" x2="1">
            <stop offset="0" stop-color="#f6efe2"></stop>
            <stop offset="0.6" stop-color="#ece3d2"></stop>
            <stop offset="1" stop-color="#bfb3a0"></stop>
          </linearGradient>
          <linearGradient id="cone-fade" x1="0" x2="1">
            <stop offset="0.42" stop-color="#fff" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#fff" stop-opacity="1"></stop>
          </linearGradient>
          <radialGradient id="cone-shadow">
            <stop offset="0" stop-color="#000" stop-opacity="0.32"></stop>
            <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
          </radialGradient>
          <pattern id="cone-dots" width="6" height="6" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="1.3" fill="#151311"></circle>
          </pattern>
          <mask id="cone-mask">
            <rect width="400" height="520" fill="url(#cone-fade)"></rect>
          </mask>
          <clipPath id="cone-clip">
            <path d={body}></path>
          </clipPath>
        </defs>

        <ellipse cx="230" cy="500" rx="230" ry="22" fill="url(#cone-shadow)"></ellipse>
        <!-- base slab in perspective -->
        <path d="M 78 412 L 322 412 L 392 474 L 8 474 Z" fill="#2a2623"></path>
        <rect x="8" y="474" width="384" height="18" fill="#151311"></rect>

        <path d={body} fill="url(#cone-body)"></path>
        {bands.map((d) => <path d={d} fill="url(#cone-band)"></path>)}
        <!-- halftone shade, fading in towards the dark side -->
        <g clip-path="url(#cone-clip)" mask="url(#cone-mask)" opacity="0.45">
          <rect width="400" height="520" fill="url(#cone-dots)"></rect>
        </g>
      </svg>
    </div>

    <div class="message">
      <h1>This page didn’t make it to prod.</h1>
      <p>Already in the post-mortem. Meanwhile, the homepage is healthy.</p>
    </div>

    <a class="home" href="/">← Back to the homepage</a>
  </main>
</Base>

<style>
  .incident {
    --big: min(40vw, 56svh);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: var(--space-6);
    min-height: 100svh;
    padding-block: var(--space-5) var(--space-6);
    overflow: hidden;
  }

  /* the same spec strip as the hero: heavy top rule, hairline dividers */
  .strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule);
    border-bottom: var(--hairline);
  }

  .strip li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
  }

  .label {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .value {
    font-size: var(--step--1);
  }

  .scene {
    grid-column: 1 / -1;
    position: relative;
    align-self: center;
    height: calc(var(--big) * 1.02);
    margin-block: var(--space-6) var(--space-4);
  }

  .big {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: var(--big);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.01em;
  }

  .cone {
    position: absolute;
    left: 50%;
    bottom: calc(var(--big) * -0.24);
    height: calc(var(--big) * 1.32);
    width: auto;
    transform: translateX(-49%);
  }

  .dot,
  .square,
  .circle {
    position: absolute;
  }

  .dot {
    right: 14%;
    top: 0;
    width: calc(var(--big) * 0.09);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--mustard);
  }

  .square {
    right: 4%;
    top: calc(var(--big) * 0.08);
    width: calc(var(--big) * 0.075);
    aspect-ratio: 1;
    background: var(--vermilion);
  }

  .circle {
    left: 6%;
    bottom: calc(var(--big) * -0.42);
    width: calc(var(--big) * 0.82);
    aspect-ratio: 1;
    border: var(--hairline);
    border-radius: 50%;
  }

  .message {
    grid-column: 1 / span 2;
    align-self: end;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 30rem;
  }

  .message h1 {
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .message p {
    font-size: var(--step-0);
  }

  .home {
    grid-column: 3 / -1;
    white-space: nowrap;
    align-self: end;
    justify-self: end;
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  @media (max-width: 760px) {
    .incident {
      --big: 46vw;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-4);
    }

    .strip li:nth-child(n + 3) {
      border-top: var(--hairline);
    }

    .scene {
      margin-block: var(--space-7) var(--space-7);
    }

    .dot {
      top: calc(var(--big) * -0.22);
    }

    .message,
    .home {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
